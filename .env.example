# Copy this file to .env and fill in real values for local development.
# In production, set these as actual environment variables on the host/container -
# there is no fallback, the app will not start without them.

# PostgreSQL
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://jrmsu-sc-atvs.pages.dev
